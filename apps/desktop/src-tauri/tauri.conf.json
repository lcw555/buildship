{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buildship",
  "version": "0.2.4",
  "identifier": "com.buildship.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Buildship · 前端发布工作台",
        "width": 1320,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": true
      },
      {
        "label": "floating",
        "title": "Buildship Floating",
        "url": "floating.html",
        "width": 104,
        "height": 104,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "resources": {
      "vendor/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      },
      "wix": {
        "language": {
          "en-US": {},
          "zh-CN": { "localePath": "wix/zh-CN.wxl" }
        }
      }
    },
    "shortDescription": "前端项目本地构建、打包与 IIS 发布工具",
    "longDescription": "Buildship 帮助前端团队在桌面端完成项目纳管、构建、发布包生成（ZIP + manifest + SHA-256）、IIS 站点发布、版本管理与安全回滚。"
  }
}
